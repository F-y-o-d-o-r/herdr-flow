{
  "name": "herdr-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyboard tools for the Herdr app: leader key, repo pickers, pull all, Jira.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test 'tests/*.test.js'",
    "check": "herdr-app check mod",
    "install:local": "sh scripts/install.sh",
    "typecheck": "tsc -p mod/jsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "5.6.3"
  }
}
